# Normalize line endings to LF inside the repo on all platforms.
# This avoids the noisy "LF will be replaced by CRLF" warnings on Windows.
* text=auto eol=lf

# Shell scripts and Dockerfiles must use LF (otherwise they break in containers).
*.sh text eol=lf
Dockerfile text eol=lf
*.dockerfile text eol=lf

# Binary files should not be normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
